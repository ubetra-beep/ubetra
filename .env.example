# Copy to `.env` and fill in values for your install.
# Never commit your real `.env` file.

UBETRA_SECRET_KEY=change-me-to-a-long-random-string
UBETRA_GEMINI_API_KEY=
UBETRA_GEMINI_MODEL=gemini-3.5-flash

# Public HTTPS URL of this install (needed for OAuth callbacks / share links)
# UBETRA_PUBLIC_APP_URL=https://ubetra.example.com

# Auth / MFA
# UBETRA_MFA_REQUIRED=true
# UBETRA_MFA_LOG_CODES=false
# UBETRA_ALLOW_PUBLIC_REGISTER=true

# SMTP for email one-time codes (recommended when MFA is on)
# UBETRA_SMTP_HOST=smtp.example.com
# UBETRA_SMTP_PORT=587
# UBETRA_SMTP_USER=
# UBETRA_SMTP_PASSWORD=
# UBETRA_SMTP_FROM=noreply@example.com
# UBETRA_SMTP_TLS=true

# Local development: leave MFA off unless you configure SMTP
# UBETRA_MFA_REQUIRED=false

# Google Tasks (optional)
# UBETRA_GOOGLE_CLIENT_ID=
# UBETRA_GOOGLE_CLIENT_SECRET=
# UBETRA_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback

# Web Push (VAPID contact — some push services reject placeholders)
# Keys are auto-generated into backend/data/vapid.json on first start.
# UBETRA_VAPID_CONTACT=mailto:you@example.com

# Native Android APK push (Firebase Cloud Messaging HTTP v1)
# UBETRA_FCM_SERVICE_ACCOUNT_FILE=/app/backend/data/fcm-service-account.json
# UBETRA_FCM_PROJECT_ID=your-firebase-project-id
